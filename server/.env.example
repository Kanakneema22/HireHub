# Copy these names into server/.env and fill in your own values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>
JWT_SECRET=<generate-a-random-secret-of-at-least-32-characters>
CLIENT_URL=http://localhost:5173
PORT=5000
NODE_ENV=development

# Optional private S3-compatible object storage (AWS S3 or Cloudflare R2).
# In local development, omitting all S3_* values keeps file uploads in MongoDB. Production uploads require all S3_* values.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto